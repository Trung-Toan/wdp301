@startuml
title Create Doctor Account

actor Client
participant "Express Router" as Router
participant "authRequired" as Auth
participant "roleRequired(ADMIN_CLINIC)" as Role
participant "AdminClinicController\n(createAccountDoctor)" as Ctrl
participant "AdminClinicService\n(getAllClinicsByAdmin,\n getClinicByAdmin)" as AdminSvc
participant "DoctorService\n(createDoctor)" as DocSvc
database "MongoDB" as DB

Client -> Router: POST /account\n{ clinic_id?, specialty_id[], ... }
Router -> Auth: verify auth (req.user)
Auth --> Router: OK
Router -> Role: ensure role == ADMIN_CLINIC
Role --> Router: OK
Router -> Ctrl: createAccountDoctor(req, res)

Ctrl -> Ctrl: accountId = req.user.sub\nclinicId = req.body.clinic_id

alt clinic_id provided
  Ctrl -> AdminSvc: getAllClinicsByAdmin(accountId)
  AdminSvc -> DB: User.findOne({ account_id: accountId })
  DB --> AdminSvc: user
  AdminSvc -> DB: AdminClinic.findOne({ user_id: user._id })
  DB --> AdminSvc: adminClinic
  AdminSvc -> DB: Clinic.find({ created_by: adminClinic._id })\n.populate("specialties").sort({ createdAt:-1 }).lean()
  DB --> AdminSvc: clinics[]
  AdminSvc --> Ctrl: { ok:true, data: clinics }
  Ctrl -> Ctrl: assert clinicId ∈ clinics\n(if not, respond 403)
else no clinic_id
  Ctrl -> AdminSvc: getClinicByAdmin(accountId)
  AdminSvc -> DB: User.findOne({ account_id: accountId })
  DB --> AdminSvc: user
  AdminSvc -> DB: AdminClinic.findOne({ user_id: user._id })
  DB --> AdminSvc: adminClinic
  AdminSvc -> DB: Clinic.findOne({ created_by: adminClinic._id })\n.populate("specialties")
  DB --> AdminSvc: clinic
  AdminSvc --> Ctrl: { ok:true, data: clinic }
  Ctrl -> Ctrl: clinicId = clinic._id
end

Ctrl -> Ctrl: specialty_id = unique(String[] of req.body.specialty_id)
Ctrl -> Ctrl: payload = { ...req.body, clinic_id: clinicId, specialty_id }

Ctrl -> DocSvc: createDoctor(payload)
DocSvc -> DB: [create doctor & related writes]\n(details omitted)
DB --> DocSvc: result
DocSvc --> Ctrl: result

Ctrl --> Client: HTTP 200 or 400\nJSON result

@enduml
