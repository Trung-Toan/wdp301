@startuml
title Admin Clinic Dashboard 

actor Client
participant "Express Router" as Router
participant "authRequired" as Auth
participant "roleRequired(ADMIN_CLINIC)" as Role
participant "AdminClinicController\n(dashboard)" as Ctrl
participant "AdminClinicService\n(getDashboard)" as Svc
database "MongoDB" as DB

Client -> Router: GET /dashboard
Router -> Auth: verify auth (req.user)
Auth --> Router: OK
Router -> Role: ensure role == ADMIN_CLINIC
Role --> Router: OK
Router -> Ctrl: dashboard(req, res)

Ctrl -> Ctrl: accountId = req.user.sub
Ctrl -> Svc: getDashboard(accountId)

Svc -> DB: User.findOne({ account_id: accountId })
DB --> Svc: user
Svc -> DB: AdminClinic.findOne({ user_id: user._id })
DB --> Svc: adminClinic
Svc -> DB: Clinic.find({ created_by: adminClinic._id })\n.select("_id name status").lean()
DB --> Svc: clinics[]
Svc -> Svc: clinicIds = clinics.map(_id)

Svc -> DB: Doctor.find({ clinic_id: { $in: clinicIds } })\n.select("_id").lean()
DB --> Svc: doctors[]
Svc -> Svc: doctorIds = doctors.map(_id)

Svc -> DB: Appointment.aggregate([\n  {$match:{ doctor_id:{$in:doctorIds},\n            scheduled_date:{ $gte: todayStart, $lt: todayEnd }}},\n  {$group:{ _id: "$status", count:{$sum:1} }}\n])
DB --> Svc: todayAgg[]
Svc -> Svc: todayTotal = sum(counts in todayAgg)

Svc -> DB: Appointment.countDocuments({\n  doctor_id:{ $in: doctorIds },\n  scheduled_date:{ $gte: todayStart, $lt: now+7d },\n  status:{ $in:["SCHEDULED","APPROVED"] }\n})
DB --> Svc: upcomingAppointments

Svc -> DB: Feedback.aggregate([\n  {$match:{ doctor_id:{ $in: doctorIds } }},\n  {$group:{ _id:null, avg:{ $avg:"$rating" }, total:{ $sum:1 } }}\n])
DB --> Svc: [{ avg, total }]
Svc -> Svc: avgRating = round(avg, 1)\n totalFeedbacks = total

Svc --> Ctrl: { scope:{ clinics },\n  today:{ total: todayTotal },\n  upcomingAppointments,\n  feedback:{ avgRating, totalFeedbacks } }
Ctrl --> Client: 200 JSON { success:true, data }

@enduml
