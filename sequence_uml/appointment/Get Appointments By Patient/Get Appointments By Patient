@startuml
title Get Appointments By Patient

actor Client
participant "Express Router" as Router
participant "validateObjectId(patientId)" as Validate
participant "AppointmentController\n(getByPatient)" as Ctrl
participant "AppointmentService\n(getAppointmentsByPatient)" as Svc
database "MongoDB" as DB

Client -> Router: GET /api/appointments/patient/:patientId\n?status=&page=&limit=
Router -> Validate: validate patientId
Validate --> Router: OK
Router -> Ctrl: getByPatient(req, res)

Ctrl -> Ctrl: parse { status, page=1, limit=10 }
Ctrl -> Svc: getAppointmentsByPatient(patientId, { status, page, limit })

' Build query + pagination
Svc -> Svc: filter = { patient_id, [status?] }\nskip = (page-1)*limit

' Query appointments with populations
Svc -> DB: Appointment.find(filter)\n  .populate(doctor.user,specialty,clinic)\n  .populate(slot)\n  .populate(patient.user)\n  .sort(booked_at desc)\n  .skip(skip).limit(limit).lean()
DB --> Svc: appointments[]

' Count total
Svc -> DB: Appointment.countDocuments(filter)
DB --> Svc: total

' Format response
Svc -> Svc: map to simplified records\n+ compute totalPages
Svc --> Ctrl: { total, page, limit, totalPages, data }

Ctrl --> Client: 200 JSON { ok: true, data }

@enduml
