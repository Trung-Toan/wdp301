@startuml
title Cancel Appointment

actor Client
participant "Express Router" as Router
participant "validateObjectId(id)" as Validate
participant "AppointmentController\n(cancel)" as Ctrl
participant "AppointmentService\n(cancelAppointmentAsync)" as Svc
database "MongoDB" as DB
participant "NotificationService" as Noti

Client -> Router: PUT /:id/cancel { patientId }
Router -> Validate: check ObjectId(id)
Validate --> Router: OK
Router -> Ctrl: cancel(req, res)

Ctrl -> Ctrl: parse appointmentId, patientId\nvalidate both are ObjectId
Ctrl -> Svc: cancelAppointmentAsync(appointmentId, patientId)

' Load appointment & permission
Svc -> DB: Appointment.findById(appointmentId)
DB --> Svc: appointment
Svc -> Svc: assert appointment.patient_id == patientId
Svc -> Svc: assert status in { SCHEDULED, APPROVE }

' Update status
Svc -> Svc: appointment.status = CANCELLED
Svc -> DB: appointment.save()
DB --> Svc: saved

' Populate for response / notification
Svc -> DB: Appointment.findById(_id)\n + populate doctor(user), specialty, clinic
DB --> Svc: populated

' Notify (best-effort)
Svc -> Noti: createAppointmentStatusUpdateNotification(populated, "CANCELLED")
Noti --> Svc: done (or logged)

Svc --> Ctrl: populated
Ctrl --> Client: 200 JSON { ok: true, data }

@enduml
