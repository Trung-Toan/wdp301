@startuml
title Check Slot Availability

actor Client
participant "Express Router" as Router
participant "AppointmentController\n(checkSlotAvailability)" as Ctrl
participant "AppointmentService\n(checkSlotAvailability)" as Svc
database "MongoDB" as DB

Client -> Router: GET /slots/:slotId/check-availability\n?scheduledDate=&patientId=
Router -> Ctrl: checkSlotAvailability(req, res)

Ctrl -> Ctrl: validate slotId & scheduledDate
Ctrl -> Svc: checkSlotAvailability(slotId, scheduledDate)
Svc -> DB: compute availability for slot (bookedCount, maxPatients)
DB --> Svc: { isAvailable, reason?, bookedCount, maxPatients, remainingSlots }
Svc --> Ctrl: result

alt patientId provided and valid
  Ctrl -> DB: Appointment.findOne({ slot_id, patient_id,\n date = scheduledDate (same day),\n status in [SCHEDULED, COMPLETED] })
  DB --> Ctrl: existing | null
  alt existing found
    Ctrl -> Ctrl: result.isAvailable = false\nresult.reason = "Patient already has an appointment in this slot"
  end
end

Ctrl --> Client: 200 JSON {\n  canBook: result.isAvailable,\n  reason: result.reason,\n  bookedCount: result.bookedCount,\n  maxPatients: result.maxPatients,\n  remainingSlots: result.remainingSlots\n}

@enduml
