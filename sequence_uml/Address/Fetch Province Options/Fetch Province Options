@startuml
title Fetch Province Options

actor Client
participant "Express Router" as Router
participant "ProvinceController\n(ctrl.getProvinceOptions)" as Ctrl
participant "ProvinceService\n(listProvinceOptions)" as Svc
database "MongoDB" as DB

Client -> Router: GET /provinces/options\n?q=&region=&sort=
Router -> Ctrl: ctrl.getProvinceOptions(req, res)
Ctrl -> Svc: listProvinceOptions(req.query)

Svc -> Svc: filter = {}
opt Has valid q
  Svc -> Svc: rx = new RegExp(q, "i")\nfilter.$or = [fullName|shortName|code: rx]
end
opt Has region
  Svc -> Svc: filter.region = region
end

Svc -> DB: Province.find(filter)\n.sort(sort || "fullName")\n.select("code shortName fullName type region -_id").lean()
DB --> Svc: docs[]

Svc -> Svc: options = docs.map(p => ({\n value: p.code,\n label: p.shortName || p.fullName,\n meta: { fullName: p.fullName, type: p.type, region: p.region }\n}))

Svc --> Ctrl: options
Ctrl -> Ctrl: setCache(res)
Ctrl --> Client: 200 JSON { success: true, options }

@enduml
